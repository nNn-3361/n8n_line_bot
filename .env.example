# Copy this file to .env only after Step 2 adds compose.yaml.
# This file intentionally contains no credentials or secret values.

COMPOSE_PROJECT_NAME=lnta
TZ=Asia/Taipei
GENERIC_TIMEZONE=Asia/Taipei

# Replace with the public HTTPS origin only when the reverse proxy and Funnel
# are ready. Keep the trailing slash.
N8N_WEBHOOK_URL=https://replace-with-funnel-host.example/

# Confirm this value from the deployed HTTP proxy chain before production.
N8N_PROXY_HOPS=1

N8N_PAYLOAD_SIZE_MAX=2
EXECUTIONS_TIMEOUT=120
EXECUTIONS_TIMEOUT_MAX=300
# V0 uses one writer to reduce Data Table race conditions.
N8N_CONCURRENCY_PRODUCTION_LIMIT=1
N8N_DATA_TABLES_MAX_SIZE_BYTES=52428800
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=none
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=1000
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES=true
# Local editor uses http://localhost. Change to true when the editor itself is
# served through a private HTTPS endpoint.
N8N_SECURE_COOKIE=false

# Keep nginx.conf until the verifier has real local Docker secrets and passes
# its integration tests. Then change to nginx.line.conf and enable the `line`
# Compose profile.
LNTA_PROXY_CONFIG=nginx.conf

# LINE Channel Secret, allowed LINE user ID, and the verifier-to-n8n internal
# token are intentionally absent; store them in the ignored Docker secret
# files documented in LOCAL_SETUP.md.
# Configure the LINE Channel Access Token and Gemini API key through n8n
# Credentials. Never put any of these values in this file or workflow exports.
